{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny"
  },
  "mcp": {
    "penpot": {
      "type": "local",
      "command": ["npx", "-y", "@penpot/mcp@stable"],
      "enabled": true,
      "environment": {
        "PENPOT_ACCESS_TOKEN": "{env:PENPOT_ACCESS_TOKEN}"
      }
    }
  }
}